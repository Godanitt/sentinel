set working-directory := ".."

# -*-Makefile-*-

test:
     cargo nextest run --profile fast

verbose regexp:
     cargo nextest run --no-capture --profile full -E "test({{regexp}})"

test-slow:
     cargo nextest run --release --profile full

build:
    cargo build

clean:
    cargo clean

debug bin *args:
    cargo run           --bin {{bin}} -- {{args}}

release bin *args:
    cargo run --release --bin {{bin}} -- {{args}}
